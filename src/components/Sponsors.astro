---
// Sponsors.astro — sponsor logos grouped by tier, the sponsorship tiers, and a one-line ask at the bottom.
//
// Reads `sponsors`, `sponsorPackages`, and `links.prospectus` / `links.email` from event.ts. The packages table
// (Bronze → Platinum) shows what each sponsorship level includes. With no sponsors yet, it shows a
// "be our first sponsor" message instead of an empty grid — an empty grid looks like nobody believes in the event.
import { event, type SponsorTier } from "../content/event";
import Section from "./Section.astro";
import Star from "./Star.astro";


// Each tier's name and color, used by both the logo groups and the packages table. Colors are metal-like:
// platinum = icy blue-white, gold = yellow, silver = light gray, bronze = copper orange.
// Full class names written out (Tailwind only generates classes it can find spelled out in the code).
const TIER_STYLE: Record<SponsorTier, { label: string; text: string; bar: string }> = {
  platinum: { label: "Platinum", text: "text-[#cfe3ff]", bar: "bg-[#cfe3ff]" },
  gold: { label: "Gold", text: "text-volt", bar: "bg-volt" },
  silver: { label: "Silver", text: "text-mist", bar: "bg-mist" },
  bronze: { label: "Bronze", text: "text-[#d08a52]", bar: "bg-[#d08a52]" },
};

// Logo groups, highest tier first, with logo heights: bigger sponsors get bigger logos (part of what they pay for).
const tiers: { tier: SponsorTier; label: string; logoClass: string; labelClass: string }[] = [
  { tier: "platinum", label: "Platinum", logoClass: "h-20", labelClass: TIER_STYLE.platinum.text },
  { tier: "gold", label: "Gold", logoClass: "h-16", labelClass: "text-volt" },
  { tier: "silver", label: "Silver", logoClass: "h-12", labelClass: TIER_STYLE.silver.text },
  { tier: "bronze", label: "Bronze", logoClass: "h-10", labelClass: TIER_STYLE.bronze.text },
];

// Only keep tiers that actually have sponsors, so we don't print an empty "Bronze" heading.
const groups = tiers
  .map((t) => ({ ...t, sponsors: event.sponsors.filter((s) => s.tier === t.tier) }))
  .filter((g) => g.sponsors.length > 0);
---

<Section id="sponsors" title="Sponsors" lead="The companies and organizations making the day possible." accent="ember">
  {
    groups.length === 0 ? (
      <p class="text-lg text-muted">We're lining up sponsors now. Want your logo here first?</p>
    ) : (
      <div class="space-y-10">
        {groups.map((g) => (
          <div>
            <h3 class:list={["font-display text-sm font-semibold tracking-widest uppercase", g.labelClass]}>{g.label}</h3>
            <ul class="mt-4 flex flex-wrap items-center gap-x-10 gap-y-6">
              {g.sponsors.map((s) => (
                <li>
                  {/* Logos sit on a light tile because most company logos are designed for white backgrounds and
                      would disappear on black. */}
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="block rounded-lg bg-fg p-4 transition-transform motion-safe:hover:scale-105">
                    {/* alt is the sponsor's name, so the link still makes sense if the image fails or for screen readers.
                        w-auto keeps the logo's own proportions; the tier sets only the height. */}
                    <img src={s.logo} alt={s.name} loading="lazy" class:list={["w-auto max-w-[12rem] object-contain", g.logoClass]} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }

  {
    event.sponsorPackages.length > 0 && (
      <div class="mt-12">
        <h3 class="font-display text-2xl font-semibold">Sponsorship tiers</h3>
        {/* One card per tier, lowest to highest: 1 column on phones, 2 per row from 640px up.
            The top tier (last in the list) gets a highlighted frame. */}
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {event.sponsorPackages.map((p, i) => {
            const style = TIER_STYLE[p.tier];
            const top = i === event.sponsorPackages.length - 1;
            return (
              <li class:list={["chamfer-frame", top && "bg-[#cfe3ff]/50"]} style="--cut: 18px">
                <div class="chamfer flex h-full flex-col bg-card px-6 py-6" style="--cut: 18px">
                  <span aria-hidden="true" class:list={["accent-bar w-8", style.bar]} />
                  <p class:list={["mt-4 font-display text-xl font-bold", style.text]}>{style.label}</p>
                  <p class="mt-1 font-display text-2xl font-bold tracking-tight">{p.amount ?? "TBA"}</p>
                  <ul class="mt-4 space-y-2 text-sm text-fg/85">
                    {p.perks.map((perk) => (
                      <li class="flex gap-2">
                        <Star class:list={["mt-1 size-3 shrink-0", style.text]} />
                        {perk}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  <!--
    The ask: one centered line, always shown (we want new sponsors even after we have some). The "prospectus"
    link only appears once links.prospectus is set; until then it's just the email.
  -->
  {
    event.links.email && (
      <p class="mx-auto mt-12 max-w-2xl text-center text-lg text-fg/90">
        Help us make this event possible!{" "}
        {event.links.prospectus && (
          <>
            Check out our{" "}
            <a href={event.links.prospectus} target="_blank" rel="noopener noreferrer" class="text-fg underline underline-offset-4 hover:text-aero">
              prospectus<span class="sr-only"> (opens in a new tab)</span>
            </a>{" "}
            for more information or email
          </>
        )}
        {!event.links.prospectus && "Email"} us at{" "}
        <a href={`mailto:${event.links.email}?subject=${encodeURIComponent(`Sponsoring ${event.name}`)}`} class="[overflow-wrap:anywhere] text-fg underline underline-offset-4 hover:text-aero">
          {event.links.email}
        </a>
        .
      </p>
    )
  }
</Section>
