---
// Sponsors.astro — sponsor logos grouped by tier, plus the pitch for companies thinking about sponsoring.
//
// Reads `sponsors`, `sponsorPitch`, and the sponsor links from event.ts. With no sponsors yet, it shows a
// "be our first sponsor" message instead of an empty grid — an empty grid looks like nobody believes in the event.
import { event, type SponsorTier } from "../content/event";
import { sponsorCta } from "../lib/cta";
import Section from "./Section.astro";
import CtaButton from "./CtaButton.astro";
import Star from "./Star.astro";

const cta = sponsorCta();

// Tiers in display order, with logo heights: bigger sponsors get bigger logos, which is part of what they pay for.
// Each tier label also gets its own color.
const tiers: { tier: SponsorTier; label: string; logoClass: string; labelClass: string }[] = [
  { tier: "gold", label: "Gold", logoClass: "h-16", labelClass: "text-volt" },
  { tier: "silver", label: "Silver", logoClass: "h-12", labelClass: "text-fg" },
  { tier: "bronze", label: "Bronze", logoClass: "h-10", labelClass: "text-ember" },
];

// Only keep tiers that actually have sponsors, so we don't print an empty "Bronze" heading.
const groups = tiers
  .map((t) => ({ ...t, sponsors: event.sponsors.filter((s) => s.tier === t.tier) }))
  .filter((g) => g.sponsors.length > 0);
---

<Section id="sponsors" title="Sponsors" lead="The companies and organizations making the day possible." accent="ember">
  {
    groups.length === 0 ? (
      <p class="text-lg text-muted">We're lining up sponsors now. Want your logo here first?</p>
    ) : (
      <div class="space-y-10">
        {groups.map((g) => (
          <div>
            <h3 class:list={["font-display text-sm font-semibold tracking-widest uppercase", g.labelClass]}>{g.label}</h3>
            <ul class="mt-4 flex flex-wrap items-center gap-x-10 gap-y-6">
              {g.sponsors.map((s) => (
                <li>
                  {/* Logos sit on a light tile because most company logos are designed for white backgrounds and
                      would disappear on black. */}
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="block rounded-lg bg-fg p-4 transition-transform motion-safe:hover:scale-105">
                    {/* alt is the sponsor's name, so the link still makes sense if the image fails or for screen readers.
                        w-auto keeps the logo's own proportions; the tier sets only the height. */}
                    <img src={s.logo} alt={s.name} loading="lazy" class:list={["w-auto max-w-[12rem] object-contain", g.logoClass]} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }

  <!-- The pitch box: a cut-corner card (see global.css). It's always shown: we want new sponsors even after we have some. -->
  <div class="chamfer-frame mt-12">
  <div class="chamfer bg-card p-6 sm:p-10">
    <h3 class="font-display text-2xl font-semibold">Why sponsor {event.name}?</h3>
    {
      event.sponsorPitch.length > 0 && (
        <ul class="mt-6 space-y-3">
          {/* A custom green star bullet instead of the default dot (Star is aria-hidden, so it isn't read aloud). */}
          {event.sponsorPitch.map((point) => (
            <li class="flex gap-3 text-fg/90">
              <Star class="mt-1 size-4 text-aero" />
              {point}
            </li>
          ))}
        </ul>
      )
    }
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <CtaButton href={cta.href} label={cta.label} external={cta.external} size="lg" />
      {
        /* The email is always written out too, so sponsors can copy it or reach a person directly. */
        event.links.email && (
          <p class="text-fg/90">
            Interested? Email{" "}
            <a href={`mailto:${event.links.email}`} class="text-sky underline underline-offset-4">
              {event.links.email}
            </a>
          </p>
        )
      }
    </div>
  </div>
  </div>
</Section>
