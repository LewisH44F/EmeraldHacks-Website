---
// Tracks.astro — the themes teams can build for, as cut-corner cards.
//
// Reads `tracks` from event.ts. Each card gets an accent color (green → orange → blue, repeating) for its dot and
// title. If a track has its own prize set, it's shown on the card; overall prizes live in the Prizes section.
// If the list is empty, a "Revealed on event day" card shows instead.
import { event } from "../content/event";
import Section from "./Section.astro";

// Full class names written out (Tailwind only generates classes it can find spelled out in the code).
const accents = [
  { text: "text-aero", dot: "bg-aero" },
  { text: "text-ember", dot: "bg-ember" },
  { text: "text-sky", dot: "bg-sky" },
];
---

<Section id="tracks" title="Tracks" lead="Pick a theme for your project, or build across them." accent="ember">
  {
    event.tracks.length === 0 ? (
      <div class="chamfer-frame">
        <div class="chamfer bg-card px-8 py-12">
          <span aria-hidden="true" class="octagon block size-3.5 bg-aero" />
          <p class="mt-5 font-display text-2xl font-bold text-aero sm:text-3xl">Revealed on event day</p>
          <p class="mt-3 text-muted">Tracks will be released on the day of the event.</p>
        </div>
      </div>
    ) : (
      // 1 column on phones, 2 from 640px up. auto-rows-fr keeps cards in the same row equally tall.
      <ul class="grid auto-rows-fr gap-5 sm:grid-cols-2">
        {event.tracks.map((t, i) => {
          const accent = accents[i % accents.length]!;
          return (
            // The first track gets a green frame and a slightly lighter card, as a gentle "featured" look.
            <li class:list={["chamfer-frame", i === 0 && "bg-aero/60"]}>
              <div class:list={["chamfer flex h-full flex-col px-8 py-9", i === 0 ? "bg-[#1a2c27]" : "bg-card"]}>
                <span aria-hidden="true" class:list={["octagon block size-3.5", accent.dot]} />
                <h3 class:list={["mt-5 font-display text-2xl font-bold", accent.text]}>{t.name}</h3>
                <p class="mt-3 flex-1 text-fg/85">{t.description}</p>
                {t.prize && <p class="mt-6 text-sm font-semibold text-volt">Prize: {t.prize}</p>}
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</Section>
