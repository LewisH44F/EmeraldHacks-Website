---
// Tracks.astro — the themes teams can build for, each with its prize (or "Prize TBA").
//
// Reads `tracks` from event.ts. If the list is empty, it shows a "coming soon" note instead of a blank section.
import { event } from "../content/event";
import Section from "./Section.astro";

// Each card gets an accent color, cycling green → blue → yellow, so the grid doesn't look monotone.
// These are full class names (not built from pieces) because Tailwind only generates classes it can find
// written out in full in the source code.
const accents = ["text-aero", "text-sky", "text-volt"];
---

<Section id="tracks" title="Tracks & prizes">
  {
    event.tracks.length === 0 ? (
      <p class="text-muted">Tracks and prizes will be announced soon.</p>
    ) : (
      // Cards stack on phones, 2 across on tablets, 3 on desktop. auto-rows-fr keeps every card in a row the same height.
      <ul class="grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {event.tracks.map((t, i) => (
          // motion-safe:hover:-translate-y-1 lifts the card slightly on hover, but only if motion is allowed.
          <li class="spotlight flex flex-col rounded-xl border border-line p-6 transition-[translate,border-color] hover:border-aero/50 motion-safe:hover:-translate-y-1">
            <p aria-hidden="true" class:list={["font-display text-sm font-bold", accents[i % accents.length]]}>
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 font-display text-xl font-semibold">{t.name}</h3>
            <p class="mt-2 flex-1 text-muted">{t.description}</p>
            {/* mt-4 + flex-1 above pins the prize line to the bottom of the card so prizes line up across cards. */}
            <p class="mt-6 border-t border-line pt-4 text-sm font-semibold">
              Prize: <span class:list={["font-normal", t.prize ? "text-volt" : "text-muted"]}>{t.prize ?? "TBA"}</span>
            </p>
          </li>
        ))}
      </ul>
    )
  }
</Section>
