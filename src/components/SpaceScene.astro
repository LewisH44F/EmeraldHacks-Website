---
// SpaceScene.astro — a scattering of twinkling stars behind the site.
//
// Like the constellation background (SkyField), it's fixed behind all content,
// ignores taps, and is pure CSS animation. The twinkle is slow on purpose: it's a backdrop, not a feature.

// Twinkling stars: position (% of the screen), size (px), color, and a delay so they don't blink in unison.
// I picked the spots by hand to avoid the middle of the screen, where the text is.
const stars = [
  { x: 6, y: 14, s: 10, c: "#ffd23f", d: 0 },
  { x: 92, y: 9, s: 8, c: "#eef3f1", d: 1.4 },
  { x: 17, y: 58, s: 7, c: "#5b9bff", d: 2.6 },
  { x: 84, y: 38, s: 9, c: "#39d98a", d: 0.8 },
  { x: 4, y: 86, s: 8, c: "#eef3f1", d: 3.3 },
  { x: 48, y: 5, s: 6, c: "#5b9bff", d: 2 },
  { x: 70, y: 74, s: 7, c: "#ffd23f", d: 4.1 },
  { x: 30, y: 30, s: 5, c: "#eef3f1", d: 1.1 },
];
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <!-- Stars: 4-point sparkles that slowly fade in and out. -->
  {
    stars.map((st) => (
      <svg class="space-star" viewBox="0 0 24 24" style={`left:${st.x}%;top:${st.y}%;width:${st.s}px;--d:${st.d}s`}>
        <path d="M12 0 C13 8 16 11 24 12 C16 13 13 16 12 24 C11 16 8 13 0 12 C8 11 11 8 12 0 Z" fill={st.c} />
      </svg>
    ))
  }
</div>

<style>
  .space-star {
    position: absolute;
    height: auto;
    opacity: 0.2;
    animation: space-twinkle 5s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes space-twinkle {
    0%,
    100% {
      opacity: 0.15;
      transform: scale(0.7);
    }
    50% {
      opacity: 0.85;
      transform: scale(1);
    }
  }

  /* "Reduce motion": the stars stay, but don't twinkle. */
  @media (prefers-reduced-motion: reduce) {
    .space-star {
      animation: none;
      opacity: 0.5;
    }
  }

  @media print {
    .space-star {
      display: none;
    }
  }
</style>
