---
// About.astro — explains what a hackathon is, who can come, and what it costs. Written for beginners and parents.
//
// The paragraphs come from `about` in event.ts. The "quick facts" list uses `eligibility`, `cost`, and
// `experience`; anything null shows "TBA" (or, for experience, is left out) so we never promise something unconfirmed.
import { event } from "../content/event";
import { registerCta } from "../lib/cta";
import { TBA } from "../lib/format";
import Section from "./Section.astro";
import CtaButton from "./CtaButton.astro";

const cta = registerCta();

// I build the facts as data first, then loop, so adding a new fact is one line here instead of more markup.
const facts = [
  { label: "Who", value: event.eligibility ?? TBA },
  { label: "Cost", value: event.cost ?? TBA },
  { label: "Length", value: "12 hours, one day. Not overnight." },
  { label: "Experience", value: event.experience },
].filter((f) => f.value !== null);
---

<!-- split={false}: About's own two-column layout (text + facts box) needs the full width. -->
<Section id="about" title={`What is ${event.name}?`} lead="Everything you need to know before you sign up." accent="aero" split={false}>
  <!--
    lg:grid-cols-[3fr_2fr] puts the text and the facts side by side on wide screens, text getting more room.
    If `about` is empty I drop to a single column, otherwise the facts box would sit next to a blank gap.
  -->
  <div class:list={["grid gap-10", event.about.length > 0 && "lg:grid-cols-[3fr_2fr]"]}>
    {
      event.about.length > 0 && (
        <div class="max-w-prose space-y-5 text-lg leading-relaxed text-fg/90">
          {event.about.map((para) => <p>{para}</p>)}
        </div>
      )
    }

    <!-- A cut-corner card (chamfer-frame/chamfer in global.css) to match the rest of the site. -->
    <div class="chamfer-frame max-w-md">
    <dl class="chamfer space-y-5 bg-card p-7">
      {
        facts.map((f) => (
          <div>
            <dt class="text-xs font-semibold tracking-widest text-aero uppercase">{f.label}</dt>
            <dd class="mt-1 font-medium">{f.value}</dd>
          </div>
        ))
      }
    </dl>
    </div>
  </div>

  <div class="mt-8">
    <CtaButton href={cta.href} label={cta.label} size="lg" />
  </div>
</Section>
