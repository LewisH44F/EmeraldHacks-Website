---
// SkyField.astro — the constellation background behind the whole site.
//
// A field of points joined by thin lines (constellations), drawn in the same low-poly style as the logo.
// It moves ONLY when you scroll, by a fixed amount per pixel scrolled:
//   • Scroll down → the stars glide up past you, near ones faster than far ones (parallax), so the page feels
//     like it has depth. Scroll back up → they glide back to exactly where they were.
//   • The color shifts green → blue → yellow as you move down the page.
// It does not react to clicks, taps, or the mouse, and it never animates on its own. When you're not scrolling
// it costs nothing at all, which is what keeps phones smooth.
//
// It's drawn on a <canvas> (a blank drawing surface), which is much cheaper than hundreds of HTML elements.
// It sits fixed behind the content and ignores clicks (pointer-events-none).
// No props: it's purely decorative and reads nothing from event.ts.
---

<!--
  h-screen h-lvh: "lvh" = the LARGE viewport height on phones (as if the address bar were hidden). Sizing to it
  means no strip of empty background appears at the bottom when the address bar slides away. Browsers that don't
  know lvh (older Safari) ignore it and use h-screen, written first as the fallback.
  -z-10 puts it behind everything. aria-hidden because it carries no information for screen readers.
-->
<div aria-hidden="true" class="skyfield-bg pointer-events-none fixed top-0 left-0 -z-10 h-screen h-lvh w-full">
  <canvas id="skyfield" class="h-full w-full"></canvas>
</div>

<style>
  /* Soft green and blue glows in opposite corners, visible even before (or without) the canvas.
     Plain rgba() colors (instead of color-mix()) so it looks the same on older iPhones too. */
  .skyfield-bg {
    background:
      radial-gradient(ellipse at 20% 0%, rgba(57, 217, 138, 0.14), transparent 55%),
      radial-gradient(ellipse at 90% 100%, rgba(91, 155, 255, 0.12), transparent 50%);
  }
</style>

<script>
  const canvas = document.getElementById("skyfield") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Brand colors as RGB, matching --color-aero / --color-sky / --color-volt in global.css.
  const PALETTE: [number, number, number][] = [
    [57, 217, 138],
    [91, 155, 255],
    [255, 210, 63],
  ];

  // How far the stars move per pixel scrolled. 0.35 = a near star moves 35px for every 100px you scroll;
  // far stars move less (depth). Raise it for a stronger effect.
  const PARALLAX = 0.35;
  // Lines are drawn between stars closer than this (in pixels).
  const LINK_DIST = 120;

  interface Star {
    x: number; // home position on the canvas, before scrolling
    y: number;
    depth: number; // 0.3 (far) .. 1 (near): size, brightness, and how much it moves with scroll
  }

  let width = 0;
  let height = 0;
  let stars: Star[] = [];
  let maxScroll = 1;

  // Match the canvas's drawing surface to its real on-screen size. A canvas has two sizes: its size on the page
  // (set by CSS) and its internal pixel grid (canvas.width/height). If they don't match, the browser STRETCHES
  // the drawing, which is what made the stars look like tall smears on iPhones: the grid was set once at load,
  // then the visible area changed (address bar, toolbars). So this runs whenever the on-page size changes.
  function fitCanvas(w: number, h: number) {
    if (!canvas || !ctx) return;
    width = w;
    height = h;
    // Draw at the screen's real pixel density so lines are crisp, capped at 2 to save battery on 3x phones.
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  // Scatter a fresh set of stars over the current width and height. Roughly one star per 14,000 px², clamped
  // to 35..110, so phones get a lighter field than big monitors.
  function makeStars() {
    const count = Math.max(35, Math.min(110, Math.round((width * height) / 14000)));
    stars = Array.from({ length: count }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      depth: 0.3 + Math.random() * 0.7,
    }));
  }

  // The page's total scrollable distance; re-measured only when the page or window changes size.
  function measure() {
    maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
  }

  // Blend through the palette by how far down the page you are: top = green, middle = blue, bottom = yellow.
  function colorAt(progress: number): [number, number, number] {
    const scaled = Math.min(0.999, Math.max(0, progress)) * (PALETTE.length - 1);
    const i = Math.floor(scaled);
    const t = scaled - i;
    const a = PALETTE[i]!;
    const b = PALETTE[i + 1]!;
    return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
  }

  // Draw the whole field for the current scroll position. Called only when something changes.
  function draw() {
    if (!ctx) return;
    ctx.clearRect(0, 0, width, height);
    const scroll = window.scrollY;
    const [r, g, b] = colorAt(scroll / maxScroll);
    // With "reduce motion" on, the stars don't move with scrolling (only the color changes).
    const shift = reduceMotion.matches ? 0 : scroll * PARALLAX;

    // Each star's on-screen position: its home position moved up by the scroll (more for near stars), wrapped
    // around the top/bottom edges with a little margin so the field never runs out.
    const span = height + 40;
    const pts = stars.map((s) => {
      let y = (s.y - shift * s.depth) % span;
      if (y < -20) y += span;
      return { x: s.x, y: y - 20 + 20, depth: s.depth };
    });

    // Lines between nearby stars. Each pair is checked once; closer pairs get stronger lines.
    ctx.lineWidth = 1;
    for (let i = 0; i < pts.length; i++) {
      const a = pts[i]!;
      for (let j = i + 1; j < pts.length; j++) {
        const c = pts[j]!;
        const dx = a.x - c.x;
        const dy = a.y - c.y;
        if (Math.abs(dx) > LINK_DIST || Math.abs(dy) > LINK_DIST) continue; // cheap early exit
        const dist = Math.hypot(dx, dy);
        if (dist < LINK_DIST) {
          ctx.strokeStyle = `rgba(${r},${g},${b},${(1 - dist / LINK_DIST) * 0.22 * Math.min(a.depth, c.depth)})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(c.x, c.y);
          ctx.stroke();
        }
      }
    }

    // The stars themselves: nearer = bigger and brighter.
    for (const p of pts) {
      ctx.fillStyle = `rgba(${r},${g},${b},${0.35 + p.depth * 0.5})`;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 0.6 + p.depth * 1.4, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Scroll events can fire many times per frame; requestAnimationFrame batches them into at most one redraw
  // per screen refresh. Between scrolls, nothing runs.
  let queued = false;
  function requestDraw() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      draw();
    });
  }

  if (canvas && ctx) {
    // First size: the canvas's own size, falling back to the window if layout hasn't settled yet.
    fitCanvas(canvas.clientWidth || window.innerWidth, canvas.clientHeight || window.innerHeight);
    makeStars();
    measure();
    draw();
    window.addEventListener("scroll", requestDraw, { passive: true });

    // Whenever the canvas's on-page size changes (rotating a phone, resizing a window, the phone's address bar
    // or toolbar sliding in or out), resize the drawing surface to match, so nothing is ever stretched.
    // ResizeObserver reports the new size directly, so this never forces the browser to re-measure the page.
    //   • Width changed (rotation, new window size): scatter a fresh field for the new shape.
    //   • Only height changed (phone toolbars): keep the same stars, stretched over the new height by moving
    //     their positions (not their shapes), so nothing jumps while you scroll.
    new ResizeObserver((entries) => {
      const box = entries[0]?.contentRect;
      if (!box || box.width < 1 || box.height < 1) return;
      if (Math.abs(box.width - width) < 0.5 && Math.abs(box.height - height) < 0.5) return;
      const widthChanged = Math.abs(box.width - width) > 1;
      const scaleY = box.height / (height || box.height);
      fitCanvas(box.width, box.height);
      if (widthChanged) makeStars();
      else stars.forEach((st) => (st.y *= scaleY));
      requestDraw();
    }).observe(canvas);

    // The page gets taller after load (fonts, FAQ answers opening); keep the color mapping accurate.
    new ResizeObserver(() => {
      measure();
      requestDraw();
    }).observe(document.body);

    reduceMotion.addEventListener("change", requestDraw);
  }
</script>
