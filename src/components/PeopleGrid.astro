---
// PeopleGrid.astro — a grid of people (organizers or judges): a square, cut-corner photo tile with the name and
// role underneath. Used by Team.astro and Judges.astro so both sections look identical.
//
// Props ("props" are the inputs a component receives, like HTML attributes):
//   people     — the list from event.ts (name, role, photo)
//   emptyText  — what to show when the list is empty
import type { TeamMember } from "../content/event";
import Logo from "./Logo.astro";

interface Props {
  people: TeamMember[];
  emptyText: string;
}

const { people, emptyText } = Astro.props;
---

{
  people.length === 0 ? (
    <div class="chamfer-frame">
      <div class="chamfer flex items-center gap-5 bg-card px-8 py-10">
        <Logo bold class="h-12 w-auto shrink-0 text-aero" />
        <p class="font-display text-xl font-semibold">{emptyText}</p>
      </div>
    </div>
  ) : (
    // Two per row, like the reference design; tiles are square (aspect-square).
    <ul class="grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-6">
      {people.map((m) => (
        <li>
          <div class="chamfer-frame">
            <div class="chamfer flex aspect-square items-center justify-center overflow-hidden bg-card">
              {m.photo ? (
                // width/height let the browser reserve the space before the image loads (no layout jump).
                <img src={m.photo} alt={m.name} width="400" height="400" loading="lazy" class="size-full object-cover" />
              ) : (
                // No photo yet: our dragon mark as a placeholder. aria-hidden because the name below says who it is.
                <Logo bold class="w-1/4 text-aero/80" />
              )}
            </div>
          </div>
          <p class="mt-4 font-display text-lg font-semibold">{m.name}</p>
          <p class="text-muted">{m.role}</p>
        </li>
      ))}
    </ul>
  )
}
