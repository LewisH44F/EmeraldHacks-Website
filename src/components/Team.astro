---
// Team.astro — the organizers, from `team` in event.ts, shown with PeopleGrid.
//
// Real names and faces are one of the strongest trust signals for parents, so this section matters even
// before photos exist: people without one get a logo tile.
import { event } from "../content/event";
import Section from "./Section.astro";
import PeopleGrid from "./PeopleGrid.astro";
---

<Section id="team" title={`The people running ${event.name}`} lead="Students at Emerald High School running the day." accent="aero">
  <PeopleGrid people={event.team} emptyText="Meet the organizers soon." />
</Section>
