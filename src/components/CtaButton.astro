---
// CtaButton.astro — the one button style used for every call to action (Register, Join our Discord).
//
// It takes an href (or null). With a link it renders a real <a>; with null it renders a greyed-out, non-clickable
// label. I do it this way so we never ship a button that looks clickable but goes nowhere.
interface Props {
  href: string | null;
  label: string;
  external?: boolean; // true => opens in a new tab (used for Google Forms etc. so the site stays open)
  variant?: "primary" | "secondary";
  size?: "sm" | "lg";
}

const { href, label, external = true, variant = "primary", size = "sm" } = Astro.props;

const sizeClass = size === "lg" ? "px-6 py-3 text-base" : "px-3 py-2 text-sm";

// Primary = solid orange with near-black bold text, so the sign-up button is the most distinct thing on the page
// (nothing else is solid orange). Near-black on this orange is ~8:1 contrast, well above the 4.5:1 minimum.
// The soft orange glow makes it pop on the dark background; on hover it brightens and lifts slightly
// (motion-safe: skips the lift for reduced-motion users).
const variantClass =
  variant === "primary"
    ? "bg-ember font-bold text-ink shadow-[0_0_22px_-6px_var(--color-ember)] hover:bg-[#f79d63] hover:shadow-[0_0_30px_-4px_var(--color-ember)] motion-safe:hover:-translate-y-0.5"
    : "border border-aero/60 text-aero hover:bg-aero/10 motion-safe:hover:-translate-y-0.5";
---

{
  href ? (
    <a
      href={href}
      class:list={["inline-block rounded-md font-semibold whitespace-nowrap transition-[translate,box-shadow,background-color]", sizeClass, variantClass]}
      {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    >
      {label}
      {/* Screen readers otherwise give no warning that a new tab is about to open. */}
      {external && <span class="sr-only"> (opens in a new tab)</span>}
    </a>
  ) : (
    // No link yet (e.g. "Sign-ups soon"): the same orange button so it stays prominent, but it's plain text, not a
    // link, so it can't be clicked into nowhere. The label itself tells people it's not open yet.
    <span
      class:list={[
        "inline-block rounded-md font-semibold whitespace-nowrap",
        sizeClass,
        variant === "primary" ? "bg-ember font-bold text-ink shadow-[0_0_22px_-6px_var(--color-ember)]" : "border border-dashed border-line text-muted",
      ]}
    >
      {label}
    </span>
  )
}
