---
// Logo.astro — the Emerald Hacks mark: the head of our Aeronaut dragon drawn as angular neon line art, in the
// same single-color line style as the StangHacks mustang. It's an inline SVG (drawn with code, not an image
// file), so it stays sharp at any size, takes its color from CSS (text-aero etc.), and can "draw itself" with
// the stroke animation in global.css.
//
// It's head-only on purpose: a full dragon body turns into thin noodles at nav/favicon size. One bold
// silhouette reads at every size.
//
// To swap in an official logo later, replace the <path> lines below, or replace this component with
// <img src="/logo.svg" alt="">. The favicon (public/favicon.svg) uses the same paths and should be updated too.
interface Props {
  class?: string;
  // true => the lines animate in on page load (only used once, in the hero).
  draw?: boolean;
  // Thicker lines for small sizes (nav, footer), where the default 2.8 would look faint.
  bold?: boolean;
}

const { class: className, draw = false, bold = false } = Astro.props;
---

<!--
  viewBox is the SVG's internal coordinate window; the paths below are drawn inside it.
  pathLength="1" on every path makes the draw-in animation easy: each line counts as length 1, whatever its real length.
-->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="18 2 176 132"
  fill="none"
  stroke="currentColor"
  stroke-width={bold ? 6 : 2.8}
  stroke-linejoin="miter"
  stroke-linecap="round"
  class:list={[className, draw && "logo-draw"]}
  aria-hidden="true"
>
  <!-- Mane: swept-back flame fins, like the mascot's -->
  <path pathLength="1" d="M106 42 L76 6 L90 32 L46 14 L74 44 L24 40 L66 60 L80 52" />
  <!-- Brow + snout + upper jaw -->
  <path pathLength="1" d="M80 52 L106 42 L140 50 L188 68 L184 80 L130 86" />
  <!-- Upper teeth -->
  <path pathLength="1" d="M176 80 L172 88 L166 81 L160 89 L154 82" />
  <!-- Lower jaw -->
  <path pathLength="1" d="M130 86 L170 98 L176 104 L158 110 L124 106 L102 98" />
  <!-- Lower teeth -->
  <path pathLength="1" d="M162 96 L158 89 L152 94 L148 88 L144 92" />
  <!-- Eye (angled to look fierce) -->
  <path pathLength="1" d="M118 54 L142 57 L124 64 Z" />
  <!-- Brow spike -->
  <path pathLength="1" d="M134 49 L148 34 L146 52" />
  <!-- Nose horn -->
  <path pathLength="1" d="M168 61 L178 48 L180 65" />
  <!-- Neck, ending in a jagged cut -->
  <path pathLength="1" d="M66 60 L58 116 L68 108 L74 124 L82 112 L92 124 L102 98" />
  <!-- Cheek fin -->
  <path pathLength="1" d="M100 78 L72 76 L88 88 L70 96 L98 92" />
  <!-- Facet lines: the low-poly look -->
  <path pathLength="1" d="M140 50 L150 76 L130 86 M150 76 L188 68 M80 52 L100 78 L102 98 M118 54 L100 78" />
</svg>
