---
// Marquee.astro — a big tilted band of words that slides sideways forever, on its own (not tied to scrolling).
//
// It's pure CSS animation: no JavaScript. That makes it smooth on every device (the browser hands the movement
// to the GPU) and means it keeps working even if scripts fail. Two rows slide in opposite directions.
// The words come from `marquee` in event.ts.
//
// How the endless loop works: each row contains the SAME group of words twice, side by side. The row slides
// left by exactly 50% of its width (= one group), at which point the second copy sits exactly where the first
// one started, so the animation restarts with no visible jump.
import { event } from "../content/event";
import Star from "./Star.astro";

interface Props {
  // Flips which row goes which way, so consecutive bands don't look identical.
  reverse?: boolean;
}

const { reverse = false } = Astro.props;

// One "group" = the word list repeated twice. That's wider than a 4K screen, so there's never an empty gap.
const group = [...event.marquee, ...event.marquee];

// Row 1 alternates solid / green outline with yellow stars; row 2 alternates blue outline / solid with green stars.
const rows = [
  { dir: reverse ? "right" : "left", outlineFirst: false, stroke: "var(--color-aero)", star: "text-volt" },
  { dir: reverse ? "left" : "right", outlineFirst: true, stroke: "var(--color-sky)", star: "text-aero" },
];
---

{
  event.marquee.length > 0 && (
    // aria-hidden: it's decoration that repeats the same words; a screen reader reading it would just be noise.
    // overflow-hidden clips the extra-wide rows so the page never scrolls sideways.
    <div aria-hidden="true" class="marquee relative overflow-hidden py-10 select-none">
      {/* -rotate-2 tilts the band for energy. It's wider than the screen (w-[110%], pulled left 5%) so the tilted
          ends never show a gap at the edges. */}
      <div class="-ms-[5%] w-[110%] -rotate-2 space-y-2 border-y border-line bg-ink-2 py-4">
        {rows.map((row) => (
          <div class:list={["marquee-row flex w-max", row.dir === "right" && "marquee-row--right"]}>
            {/* The same group twice: see the loop explanation at the top of this file. */}
            {[0, 1].map(() => (
              <div class="flex shrink-0 items-center font-display text-4xl font-bold whitespace-nowrap uppercase sm:text-6xl">
                {group.map((word, i) => (
                  <>
                    <span
                      class:list={["px-[0.32em]", (i % 2 === 0) === row.outlineFirst ? "outline-text" : "text-fg"]}
                      style={`--stroke:${row.stroke}`}
                    >
                      {word}
                    </span>
                    <Star class:list={["size-[0.55em]", row.star]} />
                  </>
                ))}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  )
}

<style>
  /* The endless slide. translate3d (instead of plain translate) asks the browser to run it on the GPU, which is
     what keeps it smooth on phones and older laptops. "linear" = constant speed, no easing at the ends. */
  .marquee-row {
    animation: marquee-left 70s linear infinite;
    will-change: transform;
    /* Prevents a one-frame flicker some Safari versions show on animated, rotated layers. */
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .marquee-row--right {
    animation-name: marquee-right;
  }

  @keyframes marquee-left {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
  @keyframes marquee-right {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Hovering with a mouse pauses the band, so anyone who finds it distracting (or wants to read it) can stop it.
     (hover: hover) limits this to real mice/trackpads; on phones a tap would otherwise "stick" the pause. */
  @media (hover: hover) {
    .marquee:hover .marquee-row {
      animation-play-state: paused;
    }
  }

  /* "Reduce motion" turned on in iOS / macOS / Windows / Android settings: the band stands still. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-row {
      animation: none;
    }
  }

  /* Outlined words. Variable fonts build letters from overlapping shapes, so a plain text outline also traces
     the overlaps INSIDE each letter (stray lines). paint-order: stroke fill draws the outline first and the fill
     on top; filling with the band's own background color covers those inner lines and the inner half of the
     stroke, which is why the stroke is 3px (only ~1.5px stays visible).
     Browsers without paint-order on text (some older Firefox versions) simply show a slightly thicker outline. */
  .outline-text {
    color: var(--color-ink-2);
    -webkit-text-stroke: 3px var(--stroke);
    paint-order: stroke fill;
  }

  /* Very old browsers with no text-stroke at all: show the word in the stroke color instead of invisibly. */
  @supports not (-webkit-text-stroke: 1px) {
    .outline-text {
      color: var(--stroke);
    }
  }
</style>
