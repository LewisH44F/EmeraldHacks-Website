---
// Satellite.astro — a small satellite that slowly drifts across the background now and then, tumbling gently
// with a blinking green beacon.
//
// This file draws it and handles its small "body" animations. WHERE and WHEN it flies is decided by
// src/scripts/flights.ts (look for data-flyer="satellite"). Behind all content, ignores taps. No props.
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <!-- .flyer = moved by flights.ts. .flyer-face = mirrored so it always faces the way it's drifting. -->
  <div class="flyer satellite" data-flyer="satellite">
    <div class="flyer-face">
      <div class="satellite-tumble">
        <svg viewBox="0 0 64 40" xmlns="http://www.w3.org/2000/svg">
          <!-- Solar panels with cell lines -->
          <rect x="0" y="12" width="20" height="16" rx="1.5" fill="#5b9bff"></rect>
          <rect x="44" y="12" width="20" height="16" rx="1.5" fill="#5b9bff"></rect>
          <path d="M7 12v16M13 12v16M51 12v16M57 12v16" stroke="#07090a" stroke-width="1" opacity="0.5"></path>
          <!-- Arms + body -->
          <rect x="18" y="19" width="28" height="2" fill="#9aa8a4"></rect>
          <rect x="24" y="10" width="16" height="20" rx="3" fill="#eef3f1"></rect>
          <!-- Antenna dish + mast -->
          <path d="M32 10 L32 3" stroke="#9aa8a4" stroke-width="1.5"></path>
          <path d="M26 4 Q32 -2 38 4" fill="none" stroke="#9aa8a4" stroke-width="1.5"></path>
          <!-- Blinking beacon -->
          <circle class="satellite-beacon" cx="32" cy="20" r="2.6" fill="#39d98a"></circle>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  /* Sized from the screen width: ~44px on phones up to 76px on big screens. */
  .satellite {
    width: clamp(44px, 5vw, 76px);
    opacity: 0.9;
  }
  .satellite svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* A slow tumble back and forth, like a satellite in orbit. */
  .satellite-tumble {
    animation: satellite-tumble 14s ease-in-out infinite alternate;
  }
  @keyframes satellite-tumble {
    from {
      transform: rotate(-25deg);
    }
    to {
      transform: rotate(30deg);
    }
  }
  .satellite-beacon {
    animation: satellite-blink 2.2s steps(1, end) infinite;
  }
  @keyframes satellite-blink {
    0%,
    70% {
      opacity: 1;
    }
    71%,
    100% {
      opacity: 0.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .satellite-tumble,
    .satellite-beacon {
      animation: none;
    }
  }
</style>
