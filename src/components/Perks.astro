---
// Perks.astro — the "What You'll Get" card right under About: a two-column checklist from `perks` in event.ts.
//
// It's a single centered card instead of a full Section (no accent bar or side title) because it's a quick
// summary that belongs with About, not a destination of its own, so it isn't in the nav either.
import { event } from "../content/event";
---

{
  event.perks.length > 0 && (
    <section aria-labelledby="perks-heading" class="pb-20 sm:pb-28">
      <div class="mx-auto max-w-6xl px-4" data-reveal>
        <div class="chamfer-frame">
          <div class="chamfer bg-card px-6 py-10 sm:px-12 sm:py-14">
            <h2 id="perks-heading" class="text-center font-display text-3xl font-bold tracking-tight sm:text-5xl">
              What You'll Get
            </h2>
            {/* 1 column on phones, 2 from 640px up. The checkmark is an inline SVG (aria-hidden: decoration only). */}
            <ul class="mx-auto mt-10 grid max-w-4xl gap-x-12 gap-y-5 sm:grid-cols-2">
              {event.perks.map((perk) => (
                <li class="flex items-start gap-3 text-lg text-fg/90">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-1 size-5 shrink-0 text-aero" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12.5l5 5L20 6.5" />
                  </svg>
                  {perk}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
