---
// Nav.astro — the sticky bar at the top of the page: logo, jump links, and the Register button.
//
// The links come from src/lib/sections.ts and the button text/link from src/lib/cta.ts, so this file
// never needs editing when event details change. The <script> at the bottom adds the interactive bits:
// opening/closing the mobile menu, highlighting the section you're currently reading, and filling the
// yellow scroll-progress bar.
import { event } from "../content/event";
import { navSections } from "../lib/sections";
import { registerCta } from "../lib/cta";
import CtaButton from "./CtaButton.astro";
import Logo from "./Logo.astro";

const cta = registerCta();
---

<!--
  "fixed top-0" pins the bar to the SCREEN, not the page. (It used to be "sticky", which belongs to the page: when
  you overscrolled past the top on a phone, the page bounced down and dragged the bar off the top edge with it.)
  Because a fixed bar takes no space in the page, Base.astro adds matching padding (pt-16) to <body>.
  z-50 keeps it above section content. The semi-opaque background + blur lets content show faintly underneath.
-->
<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-ink/75 backdrop-blur-md">
  <!--
    Scroll progress bar: a thin yellow line along the bottom of the nav that fills as you read down the page.
    It starts at scaleX(0) (empty) and grows from the left (origin-left); the script updates the scale.
    I set the starting value as an inline transform instead of Tailwind's scale-x-0 class on purpose: that class
    uses the separate CSS `scale` property, which browsers MULTIPLY with the script's transform, so 0 × anything
    kept the bar invisible.
  -->
  <div id="scroll-progress" aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 origin-left bg-volt" style="transform: scaleX(0)"></div>
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4 sm:gap-4">
    <!-- Logo links back to the top. "bold" = thicker lines, so the mark stays readable at 32px tall. -->
    <a href="#hero" class="flex shrink-0 items-center gap-2 font-display font-bold tracking-tight">
      <Logo bold class="neon h-8 w-auto text-aero" />
      <!--
        On very narrow phones (under 400px) the name + button + hamburger don't fit on one row, so I hide the name
        visually and keep just the icon. sr-only (not display:none) keeps it readable by screen readers, which
        matters because the icon's alt is empty.
      -->
      <span class="max-[399px]:sr-only">{event.name}</span>
    </a>

    <!--
      Desktop links. "hidden lg:flex" = hidden on small screens, shown from 1024px up. I picked lg (not md)
      because six links + logo + button get cramped on 768px tablets; those get the hamburger instead.
      ms-auto pushes the links (and everything after them) to the right.
    -->
    <ul class="ms-auto hidden items-center gap-1 lg:flex">
      {
        navSections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              data-nav-link={s.id}
              class="rounded-md px-3 py-2 text-sm font-medium text-muted transition-colors hover:text-fg aria-[current=location]:text-aero"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!--
      The Register button stays visible at every screen size because it's the main thing we want people to do.
      ms-auto here only matters on mobile (where the link list above is hidden) to push it right.
    -->
    <div class="ms-auto flex items-center gap-2 lg:ms-0">
      <CtaButton href={cta.href} label={cta.label} />

      <!--
        Hamburger button, mobile only. aria-expanded tells screen readers whether the menu is open, and
        aria-controls points at the panel it opens. The script below keeps aria-expanded in sync.
      -->
      <button
        type="button"
        id="menu-toggle"
        class="rounded-md p-2 text-fg hover:bg-ink-3 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Menu</span>
        <!-- Two icons; the script swaps which one is visible. aria-hidden because the sr-only text already labels it. -->
        <svg data-icon="open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg data-icon="close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!--
    Mobile menu panel. The `hidden` attribute keeps it closed until the button is pressed.
    lg:hidden makes sure it never shows on desktop, even if it was left open before resizing.
  -->
  <div id="mobile-menu" class="border-t border-line lg:hidden" hidden>
    <ul class="mx-auto max-w-6xl px-4 py-2">
      {
        navSections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              data-nav-link={s.id}
              class="block rounded-md px-3 py-3 font-display font-medium text-muted hover:bg-ink-3 hover:text-fg aria-[current=location]:text-aero"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // This script runs in the visitor's browser (unlike the code between the --- fences above, which runs at build time).
  // Astro bundles it once and loads it as a small module, so it doesn't slow down the first paint.

  // ---------------------------------------------------------------------------
  // 1. Mobile menu
  // ---------------------------------------------------------------------------
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.querySelector('[data-icon="open"]')?.classList.toggle("hidden", open);
    toggle.querySelector('[data-icon="close"]')?.classList.toggle("hidden", !open);
  }

  // If the menu is currently hidden, the click opens it; otherwise it closes it.
  toggle?.addEventListener("click", () => setMenu(menu?.hidden === true));

  // I close the menu after a link is tapped; otherwise it would sit open on top of the section you jumped to.
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false);
  });

  // Escape closes the menu and puts keyboard focus back on the button, so keyboard users don't get lost.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) {
      setMenu(false);
      toggle?.focus();
    }
  });

  // If someone opens the menu on a narrow window and then widens it past the desktop breakpoint, reset it
  // so aria-expanded doesn't claim a menu is open when it's actually hidden by CSS.
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

  // ---------------------------------------------------------------------------
  // 2. Highlight the section currently on screen
  // ---------------------------------------------------------------------------
  // IntersectionObserver is a browser feature that tells me when an element enters or leaves a region of the
  // screen — much cheaper than checking positions on every scroll event.
  //
  // The rootMargin shrinks the "watched region" to a thin horizontal line ~40% down the screen. Whichever
  // section crosses that line is the one you're reading. A line (instead of "any part visible") avoids two
  // sections being "active" at once when both are partly on screen.
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sections = document.querySelectorAll<HTMLElement>("main section[id]");

  function setActive(id: string | null) {
    links.forEach((link) => {
      // aria-current="location" is the accessible way to say "this link points to where you are now".
      // The nav's CSS (aria-[current=location]:...) styles off this attribute, so there's no separate "active" class.
      if (link.dataset.navLink === id) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          // The hero isn't in the nav, so when it's active no link is highlighted.
          setActive(entry.target.id);
        }
      }
    },
    { rootMargin: "-40% 0px -59% 0px" },
  );

  sections.forEach((s) => observer.observe(s));

  const progress = document.getElementById("scroll-progress");

  // Edge case: the last section (FAQ) can be too short to ever reach the 40% line, so at the very bottom of
  // the page I force it active. { passive: true } tells the browser this listener never blocks scrolling.
  window.addEventListener(
    "scroll",
    () => {
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      // Fill the progress bar in proportion to how far down the page we are (0 = top, 1 = bottom).
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress?.style.setProperty("transform", `scaleX(${max > 0 ? window.scrollY / max : 0})`);
      if (atBottom && sections.length) setActive(sections[sections.length - 1].id);
    },
    { passive: true },
  );
</script>
