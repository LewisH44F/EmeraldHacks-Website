---
// Schedule.astro — the 12-hour timeline, in the order listed in `schedule` in event.ts.
//
// A vertical line with an octagon marker per item. Markers and times cycle through the accent colors
// (blue → green → orange → gray) so the eye can track down the list. While `scheduleConfirmed` is false, a
// "Tentative" label is shown so nobody plans their day around draft times.
import { event } from "../content/event";
import { formatDay, parseDate } from "../lib/format";
import Section from "./Section.astro";

// The exact date if set; otherwise the planned date plus its note (e.g. "March 20, 2027 · exact date being
// finalized"), or "Date TBA".
const day = parseDate(event.date.start)
  ? formatDay(event.date.start)
  : event.date.approx
    ? [event.date.approx, event.date.pendingNote?.toLowerCase()].filter(Boolean).join(" · ")
    : "Date TBA";

// Full class names written out (Tailwind only generates classes it can find spelled out in the code).
const accents = [
  { text: "text-sky", dot: "bg-sky" },
  { text: "text-aero", dot: "bg-aero" },
  { text: "text-ember", dot: "bg-ember" },
  { text: "text-mist", dot: "bg-mist" },
];
---

<Section id="schedule" title="Schedule" lead="How the day unfolds, start to finish." accent="sky">
  <p class="mb-10 font-display font-medium text-muted">
    {day}
    {
      !event.scheduleConfirmed && (
        <span class="ms-2 inline-block rounded-full border border-volt/60 px-2 py-0.5 font-sans text-xs font-semibold text-volt">
          Tentative
        </span>
      )
    }
  </p>
  {
    event.schedule.length === 0 ? (
      <p class="text-muted">The full schedule will be posted soon.</p>
    ) : (
      // An ordered list (<ol>) because the order matters. The ::before-style line is a 2px absolutely-positioned
      // bar behind the markers, running from the first marker to the last.
      <ol class="relative">
        <span aria-hidden="true" class="absolute top-2 bottom-2 left-[9px] w-0.5 bg-line" />
        {event.schedule.map((item, i) => {
          const accent = accents[i % accents.length]!;
          return (
            <li class="relative grid grid-cols-[20px_1fr] gap-x-6 pb-10 last:pb-0">
              {/* The marker: a 20px octagon sitting on the line. */}
              <span aria-hidden="true" class:list={["octagon mt-1 block size-5", accent.dot]} />
              <div>
                <p class:list={["font-display text-lg font-semibold tabular-nums", accent.text]}>{item.time}</p>
                <h3 class="mt-1 font-display text-xl font-semibold sm:text-2xl">{item.title}</h3>
                {item.description && <p class="mt-1 text-muted">{item.description}</p>}
              </div>
            </li>
          );
        })}
      </ol>
    )
  }
</Section>
