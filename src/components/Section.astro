---
// Section.astro — the shared wrapper for every content section (About, Tracks, Schedule, ...).
//
// I wrap sections in one component so they all get the same spacing, width, and heading style, and so
// each one is guaranteed to have the id the nav links point to. Section-specific content goes inside
// the <Section> tag and appears where <slot /> is (a "slot" is Astro's placeholder for child content).
import { navSections } from "../lib/sections";

interface Props {
  id: string; // must match an id in src/lib/sections.ts so the nav link works
  title: string; // the section's <h2>
}

const { id, title } = Astro.props;
// aria-labelledby connects the section to its heading, so screen readers announce "About, region" etc.
const headingId = `${id}-heading`;
// "01", "02"... shown above each heading, like a flight log. It's derived from the nav order automatically,
// so reordering sections in sections.ts renumbers them too.
const index = navSections.findIndex((s) => s.id === id);
const number = index >= 0 ? String(index + 1).padStart(2, "0") : null;
---

<!--
  scroll-mt-20 (scroll-margin-top: 5rem) leaves room for the 4rem sticky nav when you jump here, so the
  heading isn't hidden underneath it. py-16 gives each section breathing room.
-->
<section id={id} aria-labelledby={headingId} class="scroll-mt-20 py-20 sm:py-28">
  <!-- data-reveal: the whole section fades/slides in when it scrolls into view (see global.css). -->
  <div class="mx-auto max-w-6xl px-4" data-reveal>
    {
      number && (
        // aria-hidden: the number is decoration; screen readers already get the heading.
        <p aria-hidden="true" class="font-display text-sm font-semibold tracking-[0.3em] text-aero">
          {number} <span class="text-line">/</span> <span class="text-muted">{navSections[index]!.label.toUpperCase()}</span>
        </p>
      )
    }
    <h2 id={headingId} class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-5xl">{title}</h2>
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
