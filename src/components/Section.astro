---
// Section.astro — the shared wrapper for every content section (About, Tracks, Prizes, Schedule, ...).
//
// I wrap sections in one component so they all share the same look: a short colored accent bar, a large title,
// and a one-line subtitle on the left, with the section's content on the right. On phones the two columns
// stack. It also guarantees each section has the id the nav links point to.
//
// Section-specific content goes inside the <Section> tag and appears where <slot /> is (a "slot" is Astro's
// placeholder for child content).
interface Props {
  id: string; // must match an id in src/lib/sections.ts so the nav link works
  title: string; // the section's <h2>
  lead?: string; // one-line subtitle under the title
  accent?: "aero" | "sky" | "ember" | "mist"; // color of the little bar above the title
  split?: boolean; // true (default) = title on the left, content on the right; false = title above content
}

const { id, title, lead, accent = "aero", split = true } = Astro.props;
// aria-labelledby connects the section to its heading, so screen readers announce "Schedule, region" etc.
const headingId = `${id}-heading`;

// Full class names written out, because Tailwind only generates classes it can find spelled out in the code.
const accentClass = { aero: "bg-aero", sky: "bg-sky", ember: "bg-ember", mist: "bg-mist" }[accent];
---

<!--
  scroll-mt-20 leaves room for the 4rem sticky nav when you jump here, so the heading isn't hidden under it.
  data-reveal: the section fades/slides in when it scrolls into view (see global.css).
-->
<section id={id} aria-labelledby={headingId} class="scroll-mt-20 py-20 sm:py-28">
  <div
    class:list={[
      "mx-auto max-w-6xl px-4",
      // Split layout from 1024px up: a narrower title column (5 parts) and a wider content column (7 parts).
      split && "grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16",
    ]}
    data-reveal
  >
    <header>
      <span aria-hidden="true" class:list={["accent-bar", accentClass]}></span>
      <h2 id={headingId} class="mt-6 font-display text-4xl leading-[1.02] font-bold tracking-tight sm:text-6xl">{title}</h2>
      {lead && <p class="mt-5 max-w-md text-lg text-muted">{lead}</p>}
    </header>
    <div class:list={[!split && "mt-12"]}>
      <slot />
    </div>
  </div>
</section>
