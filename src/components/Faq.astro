---
// Faq.astro — questions and answers from `faq` in event.ts, shown as an accordion (click a question to open it).
//
// I use the browser's built-in <details>/<summary> elements instead of custom JavaScript: they open and close
// with a click or the keyboard, screen readers already understand them, and they work even if JS fails to load.
import { event } from "../content/event";
import Section from "./Section.astro";
---

<Section id="faq" title="FAQ" lead="Everything else you might be wondering." accent="mist">
  {
    event.faq.length === 0 ? (
      // The email line below covers "ask us"; this text just shouldn't promise an email that may not exist.
      <p class="text-muted">Answers to common questions are coming soon.</p>
    ) : (
      <div class="max-w-3xl space-y-3">
        {event.faq.map((item) => (
          // open: styles = a green border on the open question so you can see where you are in the list.
          // No backdrop-blur here: blur on 11 stacked cards is expensive to redraw on every scroll frame on phones.
          <details class="group rounded-xl border border-line bg-ink-2/90 transition-colors open:border-aero/50">
            {/* list-none hides the default triangle so I can draw my own "+" that rotates when open. */}
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display font-medium [&::-webkit-details-marker]:hidden">
              {item.q}
              {/* group-open:rotate-45 turns the "+" into an "×" when this <details> is open. */}
              <span aria-hidden="true" class="text-2xl leading-none text-aero transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="px-5 pb-5 leading-relaxed text-muted">{item.a}</p>
          </details>
        ))}
      </div>
    )
  }
  {
    event.links.email && (
      <p class="mt-8 text-muted">
        Still have a question? Email{" "}
        <a class="text-sky underline underline-offset-4" href={`mailto:${event.links.email}`}>
          {event.links.email}
        </a>
        .
      </p>
    )
  }
</Section>
