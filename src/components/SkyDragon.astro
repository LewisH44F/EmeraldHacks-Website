---
// SkyDragon.astro — the Aeronaut dragon, a long sky serpent (its flight is inspired by Rayquaza) that roams the
// background of the site.
//
// This file only DRAWS the dragon: a head, a chain of body segments, and a tail fin, each a separate element.
// src/scripts/dragon.ts brings it to life: it steers the head along a smooth, curving path and places every
// body segment exactly where the head was a moment earlier. That "follow the leader" trick is what makes the
// body coil through a loop-de-loop and flow out of it head-first, like a real serpent.
//
// Everything is sized in "em", and the script sets the font-size from the screen width, so the whole dragon
// scales to fit phones and big monitors alike. Behind all content, ignores taps. No props; pure decoration.

// Body segments from the neck (biggest) to the tail (smallest). The script reads each one's size from
// data-size to work out spacing along the body.
const SEGMENTS = 18;
const segments = Array.from({ length: SEGMENTS }, (_, k) => (4.72 - k * 0.16).toFixed(2));
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" data-dragon>
  <!-- The body segment shape, defined once and reused by every segment with <use>. -->
  <svg width="0" height="0" class="absolute">
    <symbol id="dragon-seg" viewBox="0 0 100 78">
      <!-- Swept-back blue fin on the back -->
      <path d="M46 12 L22 -24 L72 12 Z" fill="#5b9bff"></path>
      <!-- Body: darker green underside, lighter green top, yellow marking -->
      <rect x="0" y="8" width="100" height="62" rx="31" fill="#1f9e5c"></rect>
      <rect x="6" y="10" width="88" height="30" rx="15" fill="#39d98a"></rect>
      <path d="M44 24 L52 32 L60 24 L52 50 Z" fill="#ffd23f"></path>
    </symbol>
  </svg>

  <!--
    Parts are listed TAIL FIRST so later parts draw on top: each segment overlaps the one behind it, and the
    head sits on top of everything. The script reads them in reverse (head → tail) to place them.
  -->
  <div class="dragon-part dragon-tail" data-part="tail" style="width:4em;height:3.7em">
    <svg viewBox="0 0 60 56">
      <path d="M60 28 L20 6 L28 22 L0 4 L14 28 L0 52 L28 34 L20 50 Z" fill="#5b9bff"></path>
      <path d="M60 28 L30 20 L30 36 Z" fill="#1f9e5c"></path>
    </svg>
  </div>
  {
    [...segments].reverse().map((size) => (
      <div class="dragon-part" data-part="seg" data-size={size} style={`width:${(Number(size) * 1.3).toFixed(2)}em;height:${(Number(size) * 0.66).toFixed(2)}em`}>
        <svg viewBox="0 0 100 78">
          <use href="#dragon-seg" />
        </svg>
      </div>
    ))
  }
  <!-- Head: the logo's dragon head, filled in, facing right. -->
  <div class="dragon-part dragon-head" data-part="head" style="width:9.5em;height:8em">
    <svg viewBox="40 0 160 134">
      <path d="M106 42 L76 6 L90 32 L46 14 L74 44 L30 44 L66 64 L80 52 Z" fill="#5b9bff"></path>
      <path d="M80 52 L106 42 L140 50 L188 68 L184 80 L130 86 L170 98 L176 104 L158 110 L124 106 L102 98 L66 64 Z" fill="#1f9e5c"></path>
      <path d="M80 52 L106 42 L140 50 L188 68 L150 76 L100 78 Z" fill="#39d98a"></path>
      <path d="M134 49 L148 34 L146 52 Z M168 61 L178 48 L180 65 Z" fill="#ffd23f"></path>
      <path d="M176 80 L172 88 L166 81 L160 89 L154 82 Z M162 96 L158 89 L152 94 L148 88 L144 92 Z" fill="#eef3f1"></path>
      <path d="M118 56 L142 58 L124 65 Z" fill="#ffd23f"></path>
      <path d="M126 58 L134 59 L128 62 Z" fill="#07090a"></path>
      <path d="M100 80 L76 78 L90 90 L74 98 L100 94 Z" fill="#ffd23f"></path>
    </svg>
  </div>
</div>

<style>
  /* Every part starts far off-screen; the script moves it. Its transform places the part's CENTER on the path
     (the script ends with translate(-50%, -50%)). */
  .dragon-part {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate3d(-9999px, 0, 0);
    will-change: transform;
  }
  .dragon-part svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media print {
    [data-dragon] {
      display: none;
    }
  }
</style>
