---
// SkyDragon.astro — our Aeronaut dragon, a long sky serpent (inspired by the way Rayquaza flies) that glides
// across the background of the site, its body rippling in an S-curve.
//
// This file draws the dragon and its body ripple. WHERE it flies, and the stunts it does (loop-de-loops,
// U-turns at the edge of the screen, swoops) are decided per trip by src/scripts/flights.ts
// (look for data-flyer="dragon").
//
// The body is a chain of capsule-shaped segments. Every segment runs the same up-and-down animation, each one a
// little later than the one in front of it, which turns into a wave rolling from head to tail. A second animation
// tilts each segment along the slope of the wave, so the body reads as one smooth curve instead of a stack of
// bobbing beads. The head uses the same shapes as our logo (Logo.astro), filled in.
//
// Behind all content, ignores taps, and rests motionless for "reduce motion" users. No props; it's decoration.

// Segments from tail to head, getting bigger toward the head. --i = distance from the head (0 = head),
// which sets each segment's delay in the wave. --s = segment size in "em" (the whole dragon scales with one
// font-size, set in the <style> below).
const SEGMENTS = 18;
const segments = Array.from({ length: SEGMENTS }, (_, k) => {
  const i = SEGMENTS - k; // tail-most first
  return { i, size: (2 + k * 0.16).toFixed(2) };
});
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <!-- The body segment shape, defined once and reused by every segment with <use>. -->
  <svg width="0" height="0" class="absolute">
    <symbol id="dragon-seg" viewBox="0 0 100 78">
      <!-- Swept-back blue fin on the back -->
      <path d="M46 12 L22 -24 L72 12 Z" fill="#5b9bff"></path>
      <!-- Body: darker green underside, lighter green top, yellow marking -->
      <rect x="0" y="8" width="100" height="62" rx="31" fill="#1f9e5c"></rect>
      <rect x="6" y="10" width="88" height="30" rx="15" fill="#39d98a"></rect>
      <path d="M44 24 L52 32 L60 24 L52 50 Z" fill="#ffd23f"></path>
    </symbol>
  </svg>

  <!-- .flyer = moved by flights.ts. .flyer-face = mirrored to face the direction of travel.
       .dragon-spin = rotated by flights.ts for loop-de-loops. -->
  <div class="flyer dragon" data-flyer="dragon">
    <div class="flyer-face">
      <div class="dragon-spin">
      <div class="dragon-body">
        <!-- Tail fin -->
        <div class="dragon-seg dragon-tail" style={`--i:${SEGMENTS + 1};--s:4em`}>
          <svg viewBox="0 0 60 56">
            <path d="M60 28 L20 6 L28 22 L0 4 L14 28 L0 52 L28 34 L20 50 Z" fill="#5b9bff"></path>
            <path d="M60 28 L30 20 L30 36 Z" fill="#1f9e5c"></path>
          </svg>
        </div>
        {
          segments.map((seg) => (
            <div class="dragon-seg" style={`--i:${seg.i};--s:${seg.size}em`}>
              <svg viewBox="0 0 100 78">
                <use href="#dragon-seg" />
              </svg>
            </div>
          ))
        }
        <!-- Head: the logo's dragon head, filled in. -->
        <div class="dragon-seg dragon-head" style="--i:0;--s:7em">
          <svg viewBox="40 0 160 134">
            <path d="M106 42 L76 6 L90 32 L46 14 L74 44 L30 44 L66 64 L80 52 Z" fill="#5b9bff"></path>
            <path d="M80 52 L106 42 L140 50 L188 68 L184 80 L130 86 L170 98 L176 104 L158 110 L124 106 L102 98 L66 64 Z" fill="#1f9e5c"></path>
            <path d="M80 52 L106 42 L140 50 L188 68 L150 76 L100 78 Z" fill="#39d98a"></path>
            <path d="M134 49 L148 34 L146 52 Z M168 61 L178 48 L180 65 Z" fill="#ffd23f"></path>
            <path d="M176 80 L172 88 L166 81 L160 89 L154 82 Z M162 96 L158 89 L152 94 L148 88 L144 92 Z" fill="#eef3f1"></path>
            <path d="M118 56 L142 58 L124 65 Z" fill="#ffd23f"></path>
            <path d="M126 58 L134 59 L128 62 Z" fill="#07090a"></path>
            <path d="M100 80 L76 78 L90 90 L74 98 L100 94 Z" fill="#ffd23f"></path>
          </svg>
        </div>
      </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* One font-size scales the whole dragon (every size inside is in "em"): about 430px long on phones,
     up to ~700px on big screens. */
  .dragon {
    font-size: clamp(8px, 0.95vw, 13px);
    opacity: 0.85;
  }

  /* Loops spin around the middle of the body, so it looks like the serpent is coiling through a circle. */
  .dragon-spin {
    transform-origin: 50% 50%;
  }

  .dragon-body {
    display: flex;
    align-items: center;
    padding: 3em 0; /* room for the wave to swing up and down without clipping */
  }

  /* Each segment overlaps the one before it (negative margin) so the body is one continuous tube. */
  .dragon-seg {
    position: relative;
    flex-shrink: 0;
    width: calc(var(--s) * 1.3);
    height: calc(var(--s) * 0.66);
    margin-left: calc(var(--s) * -0.62);
    /* The wave: up and down, each segment 0.27s behind the one ahead of it. */
    animation: dragon-wave 2.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.27s);
  }
  .dragon-seg svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    /* The tilt runs a quarter-cycle (1.2s) out of step with the wave, so each segment is steepest exactly
       halfway between the top and bottom of the wave, which is what makes the curve look smooth. */
    animation: dragon-tilt 2.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.27s - 1.2s);
  }
  @keyframes dragon-wave {
    from {
      transform: translate3d(0, -2.2em, 0);
    }
    to {
      transform: translate3d(0, 2.2em, 0);
    }
  }
  @keyframes dragon-tilt {
    from {
      transform: rotate(22deg);
    }
    to {
      transform: rotate(-22deg);
    }
  }

  .dragon-tail {
    width: 4em;
    height: 4em;
    margin-left: 0;
  }
  .dragon-head {
    width: 9.5em;
    height: 8em;
    margin-left: -1.6em;
  }
  /* The head tilts less than the body, so it looks like it's steering rather than flopping. */
  .dragon-head svg {
    animation-name: dragon-head-tilt;
  }
  @keyframes dragon-head-tilt {
    from {
      transform: rotate(10deg);
    }
    to {
      transform: rotate(-10deg);
    }
  }

  /* "Reduce motion": no rippling. (flights.ts also parks the dragon instead of flying it.) */
  @media (prefers-reduced-motion: reduce) {
    .dragon-seg,
    .dragon-seg svg {
      animation: none;
    }
  }

</style>
