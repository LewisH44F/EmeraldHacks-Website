---
// Base.astro — the "layout": the shared HTML shell (<html>, <head>, <body>) that wraps the page.
// In Astro, a component is a reusable chunk of HTML in a .astro file. The part between the --- fences runs at
// BUILD time (never in the visitor's browser), so I can read the event config here for free.
// A "prop" is a value passed into a component, like an HTML attribute. This layout takes optional title/description props.
import "../styles/global.css";
import { event } from "../content/event";
import SkyField from "../components/SkyField.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${event.name} — Dublin's first 12-hour high school hackathon`,
  description = `${event.name} is a 12-hour hackathon for high school students in Dublin, run by Emerald High's Computer Science Honor Society.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Colors the phone's browser bar to match the site instead of a white strip on top. -->
    <meta name="theme-color" content="#07090a" />
    <!--
      This tiny inline script runs before the page paints. It adds a "js" class to <html>, which the scroll-reveal
      CSS in global.css waits for. That way, if JavaScript is blocked, nothing gets stuck invisible.
    -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <!-- Full SEO / Open Graph tags come in Phase 6. -->
  </head>
  <!-- font-sans = Inter for body text; antialiased makes light-on-dark text look thinner and crisper on Macs. -->
  <body class="bg-ink font-sans text-fg antialiased">
    <!--
      "Skip to content" link for keyboard and screen-reader users, so they don't have to tab through the whole nav
      on every visit. sr-only hides it visually until it gets keyboard focus (focus:not-sr-only), then it appears.
    -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-volt focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    <!-- The animated, interactive background. It's fixed behind all content. -->
    <SkyField />
    <slot />

    <script>
      // Site-wide pointer + scroll effects that don't belong to any single component.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      // 1. Scroll reveal: anything with data-reveal fades/slides in the first time it enters the screen.
      //    The actual animation is CSS (global.css); this just adds the "is-visible" class at the right moment.
      //    threshold 0.12 = trigger once 12% of the element is visible, so it animates as it arrives, not after.
      const revealer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              revealer.unobserve(e.target); // reveal once; don't re-hide when scrolling back up
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => revealer.observe(el));

      // 2. Spotlight cards: store the pointer position *relative to the card* in CSS variables (--mx, --my).
      //    The .spotlight style in global.css draws a glow at that spot. One listener on the whole document
      //    ("event delegation") is cheaper than one per card.
      document.addEventListener(
        "pointermove",
        (e) => {
          if (reduceMotion.matches) return;
          const card = (e.target as HTMLElement).closest<HTMLElement>(".spotlight");
          if (!card) return;
          const rect = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
          card.style.setProperty("--my", `${e.clientY - rect.top}px`);
        },
        { passive: true },
      );
    </script>
  </body>
</html>
