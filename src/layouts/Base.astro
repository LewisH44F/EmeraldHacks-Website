---
// Base.astro — the "layout": the shared HTML shell (<html>, <head>, <body>) that wraps the page.
// In Astro, a component is a reusable chunk of HTML in a .astro file. The part between the --- fences runs at
// BUILD time (never in the visitor's browser), so I can read the event config here for free.
// A "prop" is a value passed into a component, like an HTML attribute. This layout takes optional title/description props.
import "../styles/global.css";
import { event } from "../content/event";
import SkyField from "../components/SkyField.astro";
import SpaceScene from "../components/SpaceScene.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${event.name} — Dublin's first 12-hour high school hackathon`,
  description = `${event.name} is a 12-hour hackathon for high school students in Dublin, run by Emerald High's Computer Science Honor Society.`,
} = Astro.props;

// Absolute URLs for link previews. Social apps (iMessage, Instagram, Discord, Slack) fetch these from their own
// servers, so a relative path like "/og.png" doesn't work; they need the full https:// address.
// Astro.site comes from `site` in astro.config.mjs; update it there if the domain changes.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- The canonical URL tells search engines which address is the "real" one (e.g. if the site is also reachable
         at a Netlify preview URL), so search rankings don't get split between copies. -->
    <link rel="canonical" href={canonical} />

    <!-- Icons: SVG favicon for browser tabs; a 180×180 PNG for iPhone home screens (iOS ignores SVG icons). -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      Open Graph + Twitter card tags: these control the preview card when someone pastes our link into
      iMessage, Instagram DMs, Discord, Slack, etc. og.png is a 1200×630 image in /public. To change the
      preview picture, replace that file with another 1200×630 PNG of the same name.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={event.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${event.name}: 12 hours. Build anything.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Colors the phone's browser bar to match the site instead of a white strip on top. -->
    <meta name="theme-color" content="#07090a" />
    <!--
      This tiny inline script runs before the page paints. It adds a "js" class to <html>, which the scroll-reveal
      CSS in global.css waits for. That way, if JavaScript is blocked, nothing gets stuck invisible.
    -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <!-- font-sans = Inter for body text; antialiased makes light-on-dark text look thinner and crisper on Macs. -->
  <body class="bg-ink font-sans text-fg antialiased">
    <!--
      "Skip to content" link for keyboard and screen-reader users, so they don't have to tab through the whole nav
      on every visit. sr-only hides it visually until it gets keyboard focus (focus:not-sr-only), then it appears.
    -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-volt focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    <!-- The animated, interactive background. It's fixed behind all content. -->
    <!--
      The background layers, all fixed behind the content. Later ones draw on top of earlier ones:
      the constellations (move only when you scroll), then the twinkling stars.
    -->
    <SkyField />
    <SpaceScene />
    <slot />

    <script>
      // Scroll reveal: anything with data-reveal fades/slides in the first time it enters the screen.
      //    The actual animation is CSS (global.css); this just adds the "is-visible" class at the right moment.
      //    threshold 0.12 = trigger once 12% of the element is visible, so it animates as it arrives, not after.
      const revealer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              revealer.unobserve(e.target); // reveal once; don't re-hide when scrolling back up
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => revealer.observe(el));
    </script>
  </body>
</html>
