---
// index.astro — the one and only page of the site (Astro turns each file in src/pages into a URL; this is "/").
//
// It just stacks the section components in order. Each component reads its own data from event.ts.
// If you reorder sections here, also reorder src/lib/sections.ts so the nav matches the page.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Tracks from "../components/Tracks.astro";
import Schedule from "../components/Schedule.astro";
import Sponsors from "../components/Sponsors.astro";
import Team from "../components/Team.astro";
import Judges from "../components/Judges.astro";
import Prizes from "../components/Prizes.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Marquee from "../components/Marquee.astro";
import SocialDock from "../components/SocialDock.astro";
---

<Base>
  <Nav />
  <!-- id="main" is the target of the "Skip to content" link in Base.astro. -->
  <main id="main">
    <Hero />
    <!-- Marquee bands break up the page and slide sideways as you scroll. They're decoration (aria-hidden). -->
    <Marquee />
    <About />
    <Tracks />
    <Prizes />
    <Marquee reverse />
    <Schedule />
    <Sponsors />
    <Team />
    <Judges />
    <Faq />
  </main>
  <Footer />
  <!-- Floating Discord / Instagram / LinkedIn icons, pinned bottom-right (phones: first screen only). -->
  <SocialDock />
</Base>
